{
  "manifest_version": 3,
  "name": "Send to AI",
  "version": "4.5.1",
  "version_name": "4.5.1",
  "description": "Отправить выделенный текст в AI-ассистенты (Qwen, Minimax, Grok, Z.ai, DeepSeek, Claude, Kimi, ChatGPT, Gemini, Google AI Studio)",
  "permissions": [
    "contextMenus",
    "tabs",
    "scripting",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://chat.qwen.ai/*",
    "https://agent.minimax.io/*",
    "https://grok.com/*",
    "https://chat.z.ai/*",
    "https://chat.deepseek.com/*",
    "https://www.kimi.ai/*",
    "https://chatgpt.com/*",
    "https://gemini.google.com/*",
    "https://aistudio.google.com/*",
    "https://claude.ai/*"
  ],
  "background": {
    "service_worker": "background.bundle.js"
  },
  "action": {
    "default_title": "Send to AI",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
